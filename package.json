{
  "name": "myds",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "build:packages": "turbo build --filter=@amerfathullah/myds-react --filter=@amerfathullah/myds-style",
    "release": "pnpm build:packages && changeset publish --no-git-tag",
    "lint": "turbo lint",
    "test": "turbo test",
    "start": "turbo start",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  }
}
