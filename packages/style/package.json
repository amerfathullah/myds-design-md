{
  "name": "@govtechmy/myds-style",
  "version": "1.0.0",
  "scripts": {
    "build": "tailwindcss -i ./styles/input.tailwind.css -o ./dist/index.css --minify",
    "test": "node --test test/"
  },
  "files": [
    "README.md",
    "dist",
    "styles"
  ],
  "exports": {
    ".": {
      "style": "./styles/index.css",
      "default": "./styles/index.css"
    },
    "./fumadocs.css": {
      "style": "./styles/fumadocs.css",
      "default": "./styles/fumadocs.css"
    },
    "./full.css": {
      "default": "./dist/index.css"
    },
    "./color.css": {
      "default": "./styles/theme/color.css"
    },
    "./light.css": {
      "default": "./styles/theme/light.css"
    },
    "./dark.css": {
      "default": "./styles/theme/dark.css"
    }
  },
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
